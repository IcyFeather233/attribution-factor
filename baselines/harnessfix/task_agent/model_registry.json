{
  "openai/MODEL": {
    "max_tokens": 4096,
    "litellm_provider": "openai",
    "mode": "chat",
    "api_base": "http://localhost:8001/v1",
    "api_key_env": "TASK_MODEL_API_KEY",
    "config_name": "swebench_xml.yaml",
    "model_class": "litellm_textbased",
    "model_kwargs_override": {
      "stream": false,
      "timeout": 300,
      "max_retries": 0,
      "drop_params": true
    },
    "cost_tracking": "ignore_errors"
  }
}
